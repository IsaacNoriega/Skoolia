// --- PRISMA SCHEMA: Lead Polimórfico ---

enum LeadOriginType {
  SCHOOL
  COURSE
}

enum LeadStatus {
  NUEVO
  INTERESADO
  VISITA
  INSCRITO
}

enum LeadTrigger {
  FAVORITE
  INFO_REQUEST
  CONTACT_MESSAGE
  VISIT_SCHEDULE
  VIEW
}

model Lead {
  id           String         @id @default(uuid())
  originType   LeadOriginType
  targetId     String         // UUID de escuela o curso
  userId       String
  status       LeadStatus
  lastTrigger  LeadTrigger
  metadata     Json           // { notes: string[], tags: string[], reminderAt: Date }
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, targetId, originType])
}
